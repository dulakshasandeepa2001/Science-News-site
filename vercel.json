{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(sitemap\\.xml|news-sitemap\\.xml|post-sitemap\\.xml|page-sitemap\\.xml|category-sitemap\\.xml|rss\\.xml|feed\\.xml|robots\\.txt|llms\\.txt|favicon\\.ico|BingSiteAuth\\.xml|8d7f3e2b9c1a4e5f60718293a4b5c6d7\\.txt|rss\\.xsl|sitemap\\.xsl)",
